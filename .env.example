# ---------------------------------------------------------------------------
# MAVIRA environment. Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database / queue (docker compose sets these for its own services)
DATABASE_URL=postgresql+psycopg://mavira:mavira@localhost:5432/mavira
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=mavira
WORKER_MODE=inline            # inline (single process) | rq (Redis worker; compose default)

# OSINT
OSINT_MODE=DEMO               # DEMO = cached snapshot, no network | LIVE = search provider + live fetch
SEARCH_PROVIDER=none          # tavily | serper | brave | none
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
DEMO_STEP_DELAY_MS=150        # visible pacing of demo progress only

# LLM (optional — default is the deterministic rule-based analyzer, no egress)
LLM_PROVIDER=none             # none | openai | azure | anthropic | gemini | ollama
LLM_MODEL=                    # e.g. gpt-4o-mini, claude-sonnet-4-5, gemini-2.0-flash, llama3.1
LLM_API_BASE=                 # e.g. http://host.docker.internal:11434 for a local Ollama model
INSTALL_LLM=false             # set true to install litellm in the images
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Security
API_KEY=                      # optional shared key; the frontend proxy injects it server-side
ASSESSOR_TEAM=Team MAVIRA     # written to "Assessed By / Date"
